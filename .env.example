NODE_ENV=development
PORT=3100
FRONTEND_ORIGINS=
AGENT_API_KEY=replace-with-a-long-random-secret

MCP_SERVERS_CONFIG=./config/mcp-servers.json
MCP_CONNECT_TIMEOUT_MS=15000
MCP_CALL_TIMEOUT_MS=60000
NAUKRI_MCP_TOKEN=
LINKEDIN_MCP_TOKEN=

LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
APPLICATION_WORKER_CONCURRENCY=3
APPLICATION_QUEUE_PREFIX=job-agent
DOMAIN_LOCK_TTL_MS=180000
DOMAIN_LOCK_MAX_WAIT_MS=90000

BACKEND_API_BASE_URL=
BACKEND_API_TOKEN=
BACKEND_JOB_IMPORT_PATH=/internal/agent/jobs/import
BACKEND_APPLICATION_EVENT_PATH=/internal/agent/applications/events
BACKEND_REQUEST_TIMEOUT_MS=15000

AUTO_SUBMIT_ENABLED=false
ALLOWED_AUTO_APPLY_DOMAINS=careers.example.com,jobs.example.com
BROWSER_HEADLESS=true
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_NAVIGATION_TIMEOUT_MS=30000
RESUME_STORAGE_DIR=./private-resumes
SCREENSHOT_DIR=./artifacts
MAX_SEARCH_RESULTS=200
