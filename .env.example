SERPER_SEARCH_MAX_QUERIES=36
SERPER_SEARCH_MAX_PAGES_PER_QUERY=4
SERPER_SEARCH_MAX_REQUESTS=72
SERPER_SEARCH_MAX_PAGE_FETCHES=250
SERPER_SEARCH_CONCURRENCY=10
SERPER_SEARCH_PAGE_CRAWL_CONCURRENCY=20
NVOID_WEB_SEARCH_MAX_PAGES=10
NVOID_WEB_CRAWL_MAX_PAGES=25
NVOID_WEB_CRAWL_CONCURRENCY=6
NAUKRI_MCP_URL=
NAUKRI_MCP_TOKEN=
INDEED_MCP_URL=
INDEED_MCP_TOKEN=
LINKEDIN_MCP_URL=
LINKEDIN_MCP_TOKEN=
GLASSDOOR_MCP_URL=
GLASSDOOR_MCP_TOKEN=
APNA_MCP_URL=
APNA_MCP_TOKEN=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
