[
  {
    "id": "jobicy",
    "name": "Jobicy Live Remote Jobs",
    "enabled": true,
    "transport": "http",
    "url": "https://jobicy.com/mcp",
    "jobSearch": {
      "tool": "get_jobs",
      "arguments": {
        "tag": {
          "$profile": "jobTitle"
        },
        "count": {
          "$context": "limit"
        }
      }
    }
  },
  {
    "id": "remoteok",
    "name": "Remote OK Live Remote Jobs",
    "enabled": true,
