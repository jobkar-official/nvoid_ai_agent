    "id": "mcp-jobspy-speedyapply",
    "name": "JobSpy Universal — LinkedIn, Indeed, Naukri, Glassdoor, ZipRecruiter, Bayt, BDJobs, HelloWork",
    "enabled": true,
    "transport": "stdio",
    "command": "uvx",
    "args": [
      "mcp-jobspy@latest"
    ],
    "jobSearch": {
      "tool": "search_jobs",
      "arguments": {
        "search_term": {
          "$profile": "jobTitle"
        },
        "location": {
          "$profile": "location"
        },
        "site_name": [
          "linkedin",
          "indeed",
          "zip_recruiter",
          "glassdoor",
          "bayt",
          "naukri"
        ],
        "results_wanted": 10,
        "hours_old": 720,
