    ],
    "jobSearch": {
      "tool": "search_jobs",
      "arguments": {
        "query": {
          "$profile": "jobTitle"
        },
        "location": {
          "$profile": "location"
        },
        "limit": {
          "$context": "limit"
        }
      }
    }
  },
