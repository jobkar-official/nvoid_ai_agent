[
  {
    "id": "jobicy",
    "name": "Jobicy Live Remote Jobs",
    "enabled": true,
    "transport": "http",
    "url": "https://jobicy.com/mcp",
    "jobSearch": {
      "tool": "get_jobs",
      "arguments": {
        "tag": {
          "$profile": "jobTitle"
        },
        "count": {
          "$context": "limit"
        }
      }
    }
  },
  {
    "id": "demo",
    "name": "Nvoid Local Demo Jobs (synthetic data)",
    "enabled": false,
    "transport": "stdio",
    "command": "node",
    "args": [
      "./scripts/demo-mcp-server.cjs"
    ],
    "jobSearch": {
      "tool": "search_jobs",
      "arguments": {
        "query": {
          "$profile": "jobTitle"
        },
        "location": {
          "$profile": "location"
        },
        "limit": {
          "$context": "limit"
        }
      }
    }
  },
  {
    "id": "naukri",
    "name": "Naukri MCP",
    "enabled": false,
    "transport": "http",
    "url": "https://REPLACE-WITH-YOUR-NAUKRI-MCP-HOST/mcp",
    "headers": {
      "Authorization": "Bearer ${NAUKRI_MCP_TOKEN}"
    },
    "jobSearch": {
      "tool": "REPLACE_WITH_ACTUAL_SEARCH_TOOL_NAME",
      "arguments": {
        "query": {
          "$profile": "jobTitle"
        },
        "location": {
          "$profile": "location"
        },
        "limit": {
          "$context": "limit"
        }
      }
    }
  },
  {
    "id": "linkedin",
    "name": "LinkedIn MCP",
    "enabled": false,
    "transport": "http",
    "url": "https://REPLACE-WITH-YOUR-LINKEDIN-MCP-HOST/mcp",
    "headers": {
      "Authorization": "Bearer ${LINKEDIN_MCP_TOKEN}"
    },
    "jobSearch": {
      "tool": "REPLACE_WITH_ACTUAL_SEARCH_TOOL_NAME",
      "arguments": {
        "keywords": {
          "$profile": "jobTitle"
        },
        "location": {
          "$profile": "location"
        },
        "count": {
          "$context": "limit"
        }
      }
    }
  }
]
