{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Agent MCP server configuration",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "enabled",
      "transport"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "name": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "transport": {
        "enum": [
          "http",
          "sse",
          "stdio"
        ]
      },
      "url": {
        "type": "string"
      },
      "headers": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "command": {
        "type": "string"
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "cwd": {
        "type": "string"
      },
      "jobSearch": {
        "type": "object",
        "required": [
          "tool",
          "arguments"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          }
        }
      },
      "jobApplication": {
        "type": "object",
        "required": [
          "tool",
          "arguments"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "transport": {
              "enum": [
                "http",
                "sse"
              ]
            }
          }
        },
        "then": {
          "required": [
            "url"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "transport": {
              "const": "stdio"
            }
          }
        },
        "then": {
          "required": [
            "command"
          ]
        }
      }
    ]
  }
}